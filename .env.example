# 이 파일을 .env 로 복사한 뒤 값을 채운다.  cp .env.example .env
# .env 는 .gitignore 에 있어 커밋되지 않는다. 실제 키는 여기 넣지 말고 .env 에만 둔다.

# 필수: 본인 Anthropic API 키. 포크한 개발자는 각자 자기 키를 넣고 자기 비용으로 실행한다.
ANTHROPIC_API_KEY=

# 선택: 판정/생성에 쓸 모델. 미설정 시 claude-opus-4-8.
# 비용을 낮추려면 claude-sonnet-5 또는 claude-haiku-4-5 로 바꿀 수 있다.
ANTHROPIC_MODEL=claude-opus-4-8
